
/* =====================================
   SAIMUM AZAM — SIGNATURE BRAND
   Personal handwritten identity
===================================== */

@import url('https://fonts.googleapis.com/css2?family=Allura&display=swap');

:root {
  --brand-white: #F8FAFF;
  --brand-gold: #E4C76B;
}

/* Main signature logo */

.site-header .signature-logo,
.signature-logo {
  position: relative;
  display: inline-flex !important;
  align-items: baseline;
  gap: 5px;

  font-family: "Allura", "Segoe Script",
               "Brush Script MT", cursive !important;

  font-size: clamp(27px, 2.3vw, 36px) !important;
  font-weight: 400 !important;
  line-height: 1.1;

  white-space: nowrap;
  text-decoration: none !important;

  background: none !important;
  -webkit-background-clip: initial !important;
  -webkit-text-fill-color: initial !important;

  padding: 0 !important;
  margin: 0 !important;
}

/* First name */

.signature-logo .logo-first {
  color: var(--brand-white) !important;
  text-shadow: 0 2px 12px rgba(255,255,255,.16);
}

/* Last name */

.signature-logo .logo-last {
  color: var(--brand-gold) !important;
  text-shadow: 0 2px 12px rgba(228,199,107,.25);
}

/* Signature underline */

.signature-logo::after {
  content: "";
  position: absolute;
  left: 8%;
  right: 5%;
  bottom: -4px;
  height: 1.5px;

  background: linear-gradient(
    90deg,
    transparent,
    var(--brand-gold),
    transparent
  );

  opacity: .85;
}

/* Mobile adjustment */

@media (max-width: 700px) {
  .site-header .signature-logo,
  .signature-logo {
    font-size: 28px !important;
    gap: 3px;
  }
}
